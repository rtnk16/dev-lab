@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK JP
skinparam defaultFontSize 16
skinparam titleFontSize 24
skinparam dpi 120
skinparam componentStyle uml2
skinparam roundcorner 10
skinparam nodesep 30
skinparam ranksep 35
skinparam ArrowColor #334155
skinparam nodeBorderColor #64748B
skinparam nodeBackgroundColor #F8FAFC
skinparam componentBorderColor #2563EB
skinparam componentBackgroundColor #EFF6FF
skinparam artifactBackgroundColor #FEF3C7
skinparam artifactBorderColor #B45309
skinparam noteBackgroundColor #FFFBE8
skinparam noteBorderColor #D6B655
skinparam packageStyle rectangle
hide empty members
left to right direction
title 拡張方式とプロセス境界｜Claude Code・Copilot CLI・Codex
package "Claude Code Mods" as CLA #F5F3FF {
  node "Claude Codeのプロセス" as CP <<process>> {
    component "Harness・UI等のイベント処理" as CH
    component "Mod\nJS／TSモジュール" as MOD #EDE9FE
    CH <--> MOD : イベント／関数の結果\n同プロセス内の関数呼出し
  }
}
package "Copilot CLI Extensions" as COP #FFF1F2 {
  node "Copilot CLIのプロセス" as CCP <<process>> {
    component "Harness・拡張への振り分け" as CCH
  }
  node "ExtensionのNode.jsプロセス" as EP <<process>> {
    component "拡張SDK\nライブラリ：接続・受信・振り分け" as ES #FFE4E6
    component "自作JavaScript\nツール・コマンド・セッション状態" as EC #FFE4E6
    ES <--> EC : 登録関数の呼出し／結果
  }
  CCH <--> ES : CLIがExtensionを起動\nIPC：要求・イベント／結果
}
package "Codex：自作アプリとの連携" as CODEX #EFF6FF {
  package "方式A：対話アプリ・独自UI" as A {
    node "自作アプリのプロセス" as APP <<process>> {
      component "UI・業務ロジック\nApp Serverクライアント" as CLIENT
    }
    node "Codex App Serverのプロセス" as ASP <<process>> {
      component "Codex Harness" as AH
    }
    CLIENT <--> AH : JSON-RPC\n依頼・承認／イベント・結果
  }
  package "方式B：自動化・CI" as B {
    node "自作の自動化プロセス" as AUT <<process>> {
      component "自作コード" as AC
      component "Codex TypeScript SDK\nライブラリ" as CS
      AC --> CS : 呼出し
    }
    node "Codex CLIのプロセス" as CCLI <<process>> {
      component "Codex Harness" as BH
    }
    CS <--> BH : CLIを起動・通信\n依頼／進捗・結果
  }
}
legend bottom
代表的な実行関係。利用するCLI・SDKの版や方式で異なる場合があります。
実行環境：各プロセスを起動したローカル／リモートのホスト。
モジュール・SDKはプロセス内に読み込むコード。プロセス枠は実行の境界です。
SDK・App Serverによる外部連携と、セッション内の機能拡張は異なる入口です。
endlegend
@enduml
